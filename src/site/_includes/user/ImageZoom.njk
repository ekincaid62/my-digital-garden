<script>

document.addEventListener("DOMContentLoaded", () => {

    // ------------------------------------------------------------
    // Create the image zoom overlay
    // ------------------------------------------------------------

    const overlay = document.createElement("div");
    overlay.id = "image-zoom-overlay";

    overlay.innerHTML = `
        <div class="image-zoom-container">
            <img id="image-zoom-image" src="" alt="">
        </div>

        <button id="image-zoom-close" aria-label="Close">&times;</button>

        <div id="image-zoom-help">
            Scroll to zoom &nbsp;•&nbsp; Drag to pan &nbsp;•&nbsp; Esc to close
        </div>
    `;

    document.body.appendChild(overlay);


    // ------------------------------------------------------------
    // Get elements
    // ------------------------------------------------------------

    const zoomImage = document.getElementById("image-zoom-image");
    const container = document.querySelector(".image-zoom-container");
    const closeButton = document.getElementById("image-zoom-close");


    // ------------------------------------------------------------
    // Zoom / pan state
    // ------------------------------------------------------------

    let scale = 1;

    let translateX = 0;
    let translateY = 0;

    let dragging = false;

    let startX = 0;
    let startY = 0;


    // ------------------------------------------------------------
    // Find images in the note content
    // ------------------------------------------------------------

    const images = document.querySelectorAll("main.content img");


    images.forEach((image) => {

        image.style.cursor = "zoom-in";

        image.addEventListener("click", () => {

            zoomImage.src = image.src;
            zoomImage.alt = image.alt || "";

            // Reset position and zoom
            scale = 1;
            translateX = 0;
            translateY = 0;

            updateTransform();

            overlay.classList.add("active");
            document.body.classList.add("image-zoom-open");
        });

    });


    // ------------------------------------------------------------
    // Close viewer
    // ------------------------------------------------------------

    function closeViewer() {

        overlay.classList.remove("active");

        document.body.classList.remove("image-zoom-open");

        dragging = false;
    }


    closeButton.addEventListener("click", closeViewer);


    // Click outside the image closes the viewer
    overlay.addEventListener("click", (event) => {

        if (event.target === overlay) {
            closeViewer();
        }

    });


    // ESC closes viewer
    document.addEventListener("keydown", (event) => {

        if (
            event.key === "Escape" &&
            overlay.classList.contains("active")
        ) {
            closeViewer();
        }

    });


    // ------------------------------------------------------------
    // MOUSE WHEEL ZOOM
    //
    // This is the important part.
    //
    // The point underneath the mouse remains underneath
    // the mouse as the image zooms.
    // ------------------------------------------------------------

    container.addEventListener(
        "wheel",
        (event) => {

            event.preventDefault();

            // Mouse position relative to the container
            const rect = container.getBoundingClientRect();

            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;


            // Current center of the image
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;


            // Point on the image currently underneath the mouse
            const imageX =
                (mouseX - centerX - translateX) / scale;

            const imageY =
                (mouseY - centerY - translateY) / scale;


            // Calculate new zoom level
            const zoomFactor = event.deltaY < 0
                ? 1.15
                : 1 / 1.15;

            const newScale = Math.max(
                0.5,
                Math.min(scale * zoomFactor, 8)
            );


            // Recalculate translation so the same image point
            // stays underneath the mouse pointer
            translateX =
                mouseX -
                centerX -
                imageX * newScale;

            translateY =
                mouseY -
                centerY -
                imageY * newScale;


            scale = newScale;

            updateTransform();

        },
        { passive: false }
    );


    // ------------------------------------------------------------
    // DRAG TO PAN
    // ------------------------------------------------------------

    container.addEventListener("mousedown", (event) => {

        if (scale <= 1) {
            return;
        }

        dragging = true;

        startX = event.clientX - translateX;
        startY = event.clientY - translateY;

        container.classList.add("dragging");

    });


    document.addEventListener("mousemove", (event) => {

        if (!dragging) {
            return;
        }

        translateX = event.clientX - startX;
        translateY = event.clientY - startY;

        updateTransform();

    });


    document.addEventListener("mouseup", () => {

        dragging = false;

        container.classList.remove("dragging");

    });


    // ------------------------------------------------------------
    // DOUBLE CLICK ZOOM
    // ------------------------------------------------------------

    container.addEventListener("dblclick", (event) => {

        const rect = container.getBoundingClientRect();

        const mouseX = event.clientX - rect.left;
        const mouseY = event.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;


        if (scale <= 1) {

            // Zoom to 2x around the double-click location

            const imageX =
                (mouseX - centerX - translateX) / scale;

            const imageY =
                (mouseY - centerY - translateY) / scale;

            scale = 2;

            translateX =
                mouseX -
                centerX -
                imageX * scale;

            translateY =
                mouseY -
                centerY -
                imageY * scale;

        } else {

            // Return to normal
            scale = 1;

            translateX = 0;
            translateY = 0;
        }

        updateTransform();

    });


    // ------------------------------------------------------------
    // Apply transform
    // ------------------------------------------------------------

    function updateTransform() {

        zoomImage.style.transform =
            `translate(${translateX}px, ${translateY}px) scale(${scale})`;

    }

});

</script>
