<script>
document.addEventListener("DOMContentLoaded", function () {

    const container = document.getElementById("ancestor-chart-zoom");
    if (!container) return;

    const svg = container.querySelector("svg");
    if (!svg) return;


    /*
     * =========================================================
     * INITIAL SETTINGS
     * =========================================================
     */

    const originalViewBox = svg
        .getAttribute("viewBox")
        .split(/\s+/)
        .map(Number);

    const originalX = originalViewBox[0];
    const originalY = originalViewBox[1];
    const originalWidth = originalViewBox[2];
    const originalHeight = originalViewBox[3];

    let viewX = originalX;
    let viewY = originalY;
    let viewWidth = originalWidth;
    let viewHeight = originalHeight;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 8;
    const ZOOM_FACTOR = 1.15;


    /*
     * =========================================================
     * PAN VARIABLES
     * =========================================================
     */

    let isPanning = false;
    let didPan = false;

    let panStartX = 0;
    let panStartY = 0;

    let panStartViewX = 0;
    let panStartViewY = 0;


    /*
     * =========================================================
     * UPDATE SVG VIEWBOX
     * =========================================================
     */

    function updateViewBox() {

        svg.setAttribute(
            "viewBox",
            `${viewX} ${viewY} ${viewWidth} ${viewHeight}`
        );

    }


    /*
     * =========================================================
     * SVG DISPLAY SETTINGS
     * =========================================================
     */

    svg.setAttribute(
        "preserveAspectRatio",
        "xMidYMid meet"
    );


    /*
     * =========================================================
     * MOUSE WHEEL ZOOM
     * =========================================================
     *
     * Scroll up   = zoom in
     * Scroll down = zoom out
     *
     * Zoom occurs toward the mouse pointer.
     *
     */

    container.addEventListener(
        "wheel",
        function (event) {

            /*
             * Stop the page itself from scrolling while
             * the mouse is over the ancestor chart.
             */
            event.preventDefault();

            const rect = svg.getBoundingClientRect();

            /*
             * Mouse position within the displayed SVG,
             * expressed as a percentage.
             */
            const mouseX =
                (event.clientX - rect.left) / rect.width;

            const mouseY =
                (event.clientY - rect.top) / rect.height;


            /*
             * Determine zoom direction.
             */
            const zoomingIn = event.deltaY < 0;

            const factor = zoomingIn
                ? 1 / ZOOM_FACTOR
                : ZOOM_FACTOR;


            /*
             * Determine current zoom level.
             */
            const currentZoom =
                originalWidth / viewWidth;


            /*
             * Enforce minimum and maximum zoom.
             */
            if (zoomingIn && currentZoom >= MAX_ZOOM) {
                return;
            }

            if (!zoomingIn && currentZoom <= MIN_ZOOM) {
                return;
            }


            /*
             * Find the SVG coordinate currently underneath
             * the mouse pointer.
             */
            const pointX =
                viewX + mouseX * viewWidth;

            const pointY =
                viewY + mouseY * viewHeight;


            /*
             * Calculate the new viewBox dimensions.
             */
            const newWidth =
                viewWidth * factor;

            const newHeight =
                viewHeight * factor;


            /*
             * Adjust the viewBox position so the same SVG
             * point stays underneath the mouse.
             */
            viewX =
                pointX - mouseX * newWidth;

            viewY =
                pointY - mouseY * newHeight;

            viewWidth = newWidth;
            viewHeight = newHeight;


            updateViewBox();

        },
        { passive: false }
    );


    /*
     * =========================================================
     * START PAN
     * =========================================================
     *
     * Pan using either:
     *
     *   Shift + left mouse button
     *
     * OR
     *
     *   Middle mouse button
     *
     */

    container.addEventListener(
        "mousedown",
        function (event) {

            const shiftDrag =
                event.button === 0 && event.shiftKey;

            const middleMouse =
                event.button === 1;


            /*
             * Ignore ordinary left-clicks.
             * This is important because ordinary clicks
             * need to continue activating the ancestor links.
             */
            if (!shiftDrag && !middleMouse) {
                return;
            }


            /*
             * Prevent the browser from starting a text
             * selection or other normal mouse behavior.
             */
            event.preventDefault();


            isPanning = true;
            didPan = false;


            panStartX = event.clientX;
            panStartY = event.clientY;


            panStartViewX = viewX;
            panStartViewY = viewY;


            container.classList.add("is-panning");

        }
    );


    /*
     * =========================================================
     * PAN WHILE MOUSE MOVES
     * =========================================================
     */

    document.addEventListener(
        "mousemove",
        function (event) {

            if (!isPanning) {
                return;
            }


            /*
             * How far has the mouse moved?
             */
            const deltaX =
                event.clientX - panStartX;

            const deltaY =
                event.clientY - panStartY;


            /*
             * Don't classify the action as a drag until
             * the mouse has moved at least 5 pixels.
             *
             * This prevents tiny mouse movements from
             * turning a click into a drag.
             */
            if (
                Math.abs(deltaX) > 5 ||
                Math.abs(deltaY) > 5
            ) {

                didPan = true;

            }


            /*
             * If the mouse hasn't moved enough yet,
             * don't move the chart.
             */
            if (!didPan) {
                return;
            }


            const rect =
                svg.getBoundingClientRect();


            /*
             * Convert screen pixels into SVG viewBox
             * coordinates.
             */
            const dx =
                deltaX * (viewWidth / rect.width);

            const dy =
                deltaY * (viewHeight / rect.height);


            /*
             * Move the viewBox opposite the mouse movement.
             */
            viewX =
                panStartViewX - dx;

            viewY =
                panStartViewY - dy;


            updateViewBox();

        }
    );


    /*
     * =========================================================
     * END PAN
     * =========================================================
     */

    document.addEventListener(
        "mouseup",
        function () {

            if (!isPanning) {
                return;
            }

            isPanning = false;

            container.classList.remove("is-panning");

        }
    );


    /*
     * =========================================================
     * SUPPRESS CLICK AFTER A PAN
     * =========================================================
     *
     * This is the important part that prevents a Shift-drag
     * from accidentally activating the ancestor link that
     * happens to be underneath the mouse when the drag ends.
     *
     */

    container.addEventListener(
        "click",
        function (event) {

            if (!didPan) {
                return;
            }


            /*
             * A real drag occurred, so cancel the click.
             */
            event.preventDefault();
            event.stopPropagation();


            /*
             * Reset for the next mouse operation.
             */
            didPan = false;

        },
        true
    );


    /*
     * =========================================================
     * MIDDLE MOUSE
     * =========================================================
     *
     * Prevent the browser's normal middle-mouse behavior,
     * such as opening a link in another tab.
     *
     */

    container.addEventListener(
        "auxclick",
        function (event) {

            if (event.button === 1) {

                event.preventDefault();

            }

        }
    );


    /*
     * =========================================================
     * SAFETY RESET
     * =========================================================
     *
     * If the browser loses focus while we're dragging,
     * make sure we don't remain stuck in pan mode.
     *
     */

    window.addEventListener(
        "blur",
        function () {

            isPanning = false;
            didPan = false;

            container.classList.remove("is-panning");

        }
    );

});
</script>

    }, { passive: false });

});
</script>
