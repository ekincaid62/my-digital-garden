<script>
document.addEventListener("DOMContentLoaded", function () {

    const container = document.getElementById("ancestor-chart-zoom");
    if (!container) return;

    const svg = container.querySelector("svg");
    if (!svg) return;

    /*
     * Original SVG viewBox
     */
    const originalViewBox = svg.getAttribute("viewBox").split(/\s+/).map(Number);

    let viewX = originalViewBox[0];
    let viewY = originalViewBox[1];
    let viewWidth = originalViewBox[2];
    let viewHeight = originalViewBox[3];

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 8;
    const ZOOM_FACTOR = 1.15;

    function updateViewBox() {
        svg.setAttribute(
            "viewBox",
            `${viewX} ${viewY} ${viewWidth} ${viewHeight}`
        );
    }

    /*
     * Keep the SVG at its natural aspect ratio.
     */
    svg.setAttribute("preserveAspectRatio", "xMidYMid meet");

    /*
     * Zoom toward the mouse pointer.
     */
    container.addEventListener("wheel", function (event) {

        event.preventDefault();

        const rect = svg.getBoundingClientRect();

        /*
         * Mouse position as a percentage of the
         * currently displayed SVG.
         */
        const mouseX = (event.clientX - rect.left) / rect.width;
        const mouseY = (event.clientY - rect.top) / rect.height;

        /*
         * Determine whether we're zooming in or out.
         */
        const zoomingIn = event.deltaY < 0;
        const factor = zoomingIn
            ? 1 / ZOOM_FACTOR
            : ZOOM_FACTOR;

        /*
         * Don't allow zooming beyond our limits.
         */
        const currentZoom = originalViewBox[2] / viewWidth;

        if (zoomingIn && currentZoom >= MAX_ZOOM) return;
        if (!zoomingIn && currentZoom <= MIN_ZOOM) return;

        /*
         * Point in SVG/viewBox coordinates currently
         * underneath the mouse.
         */
        const pointX = viewX + (mouseX * viewWidth);
        const pointY = viewY + (mouseY * viewHeight);

        /*
         * Calculate the new viewBox dimensions.
         */
        const newWidth = viewWidth * factor;
        const newHeight = viewHeight * factor;

        /*
         * Move the viewBox so the point under the
         * mouse remains under the mouse.
         */
        viewX = pointX - (mouseX * newWidth);
        viewY = pointY - (mouseY * newHeight);

        viewWidth = newWidth;
        viewHeight = newHeight;

        updateViewBox();

    }, { passive: false });

});
</script>
