<script>
document.addEventListener("DOMContentLoaded", function () {

    const container = document.getElementById("ancestor-chart-zoom");
    if (!container) return;

    const svg = container.querySelector("svg");
    if (!svg) return;

    /*
     * Original SVG viewBox
     */
    const originalViewBox = svg
        .getAttribute("viewBox")
        .split(/\s+/)
        .map(Number);

    const originalX = originalViewBox[0];
    const originalY = originalViewBox[1];
    const originalWidth = originalViewBox[2];
    const originalHeight = originalViewBox[3];

    let viewX = originalX;
    let viewY = originalY;
    let viewWidth = originalWidth;
    let viewHeight = originalHeight;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 8;
    const ZOOM_FACTOR = 1.15;

    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;
    let panStartViewX = 0;
    let panStartViewY = 0;

    function updateViewBox() {
        svg.setAttribute(
            "viewBox",
            `${viewX} ${viewY} ${viewWidth} ${viewHeight}`
        );
    }

    /*
     * Preserve the SVG's proportions.
     */
    svg.setAttribute("preserveAspectRatio", "xMidYMid meet");

    /*
     * =========================================================
     * ZOOM
     * =========================================================
     */

    container.addEventListener("wheel", function (event) {

        event.preventDefault();

        const rect = svg.getBoundingClientRect();

        /*
         * Mouse position within the displayed SVG.
         */
        const mouseX = (event.clientX - rect.left) / rect.width;
        const mouseY = (event.clientY - rect.top) / rect.height;

        const zoomingIn = event.deltaY < 0;

        const factor = zoomingIn
            ? 1 / ZOOM_FACTOR
            : ZOOM_FACTOR;

        /*
         * Current zoom level.
         */
        const currentZoom = originalWidth / viewWidth;

        if (zoomingIn && currentZoom >= MAX_ZOOM) return;
        if (!zoomingIn && currentZoom <= MIN_ZOOM) return;

        /*
         * SVG coordinate underneath the mouse.
         */
        const pointX = viewX + mouseX * viewWidth;
        const pointY = viewY + mouseY * viewHeight;

        /*
         * New viewBox dimensions.
         */
        const newWidth = viewWidth * factor;
        const newHeight = viewHeight * factor;

        /*
         * Keep the point underneath the mouse.
         */
        viewX = pointX - mouseX * newWidth;
        viewY = pointY - mouseY * newHeight;

        viewWidth = newWidth;
        viewHeight = newHeight;

        updateViewBox();

    }, { passive: false });


    /*
     * =========================================================
     * PAN
     * =========================================================
     *
     * Pan with either:
     *
     *   Shift + left mouse button
     *   Middle mouse button
     *
     */

    container.addEventListener("mousedown", function (event) {

        const shiftDrag = event.button === 0 && event.shiftKey;
        const middleMouse = event.button === 1;

        if (!shiftDrag && !middleMouse) {
            return;
        }

        event.preventDefault();

        isPanning = true;

        panStartX = event.clientX;
        panStartY = event.clientY;

        panStartViewX = viewX;
        panStartViewY = viewY;

        container.classList.add("is-panning");

    });


    document.addEventListener("mousemove", function (event) {

        if (!isPanning) return;

        const rect = svg.getBoundingClientRect();

        /*
         * Convert screen movement into SVG viewBox movement.
         */
        const dx = (event.clientX - panStartX)
            * (viewWidth / rect.width);

        const dy = (event.clientY - panStartY)
            * (viewHeight / rect.height);

        viewX = panStartViewX - dx;
        viewY = panStartViewY - dy;

        updateViewBox();

    });


    document.addEventListener("mouseup", function () {

        if (!isPanning) return;

        isPanning = false;

        container.classList.remove("is-panning");

    });


    /*
     * Prevent the browser's normal middle-mouse behavior
     * while the pointer is over the chart.
     */
    container.addEventListener("auxclick", function (event) {

        if (event.button === 1) {
            event.preventDefault();
        }

    });


    /*
     * If the user releases the mouse outside the chart,
     * make sure we don't remain in pan mode.
     */
    window.addEventListener("blur", function () {

        isPanning = false;

        container.classList.remove("is-panning");

    });

});
</script>

    }, { passive: false });

});
</script>
