<script>
document.addEventListener("DOMContentLoaded", function () {

    const container = document.getElementById("ancestor-chart-zoom");
    if (!container) return;

    const svg = container.querySelector("svg");
    if (!svg) return;


    /*
     * =========================================================
     * INITIAL SETTINGS
     * =========================================================
     */

    const originalViewBox = svg
        .getAttribute("viewBox")
        .split(/\s+/)
        .map(Number);

    const originalX = originalViewBox[0];
    const originalY = originalViewBox[1];
    const originalWidth = originalViewBox[2];
    const originalHeight = originalViewBox[3];

    let viewX = originalX;
    let viewY = originalY;
    let viewWidth = originalWidth;
    let viewHeight = originalHeight;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 8;
    const ZOOM_FACTOR = 1.15;


    /*
     * =========================================================
     * PAN VARIABLES
     * =========================================================
     */

    let isPanning = false;
    let didPan = false;
    let suppressNextClick = false;

    let panStartX = 0;
    let panStartY = 0;

    let panStartViewX = 0;
    let panStartViewY = 0;


    /*
     * =========================================================
     * UPDATE SVG VIEWBOX
     * =========================================================
     */

    function updateViewBox() {

        svg.setAttribute(
            "viewBox",
            `${viewX} ${viewY} ${viewWidth} ${viewHeight}`
        );

    }


    /*
     * =========================================================
     * SVG DISPLAY SETTINGS
     * =========================================================
     */

    svg.setAttribute(
        "preserveAspectRatio",
        "xMidYMid meet"
    );


    /*
     * =========================================================
     * MOUSE WHEEL ZOOM
     * =========================================================
     */

    container.addEventListener(
        "wheel",
        function (event) {

            event.preventDefault();

            const rect = svg.getBoundingClientRect();

            const mouseX =
                (event.clientX - rect.left) / rect.width;

            const mouseY =
                (event.clientY - rect.top) / rect.height;

            const zoomingIn = event.deltaY < 0;

            const factor = zoomingIn
                ? 1 / ZOOM_FACTOR
                : ZOOM_FACTOR;

            const currentZoom =
                originalWidth / viewWidth;

            if (zoomingIn && currentZoom >= MAX_ZOOM) {
                return;
            }

            if (!zoomingIn && currentZoom <= MIN_ZOOM) {
                return;
            }

            const pointX =
                viewX + mouseX * viewWidth;

            const pointY =
                viewY + mouseY * viewHeight;

            const newWidth =
                viewWidth * factor;

            const newHeight =
                viewHeight * factor;

            viewX =
                pointX - mouseX * newWidth;

            viewY =
                pointY - mouseY * newHeight;

            viewWidth = newWidth;
            viewHeight = newHeight;

            updateViewBox();

        },
        { passive: false }
    );


    /*
     * =========================================================
     * START PAN
     * =========================================================
     *
     * Left mouse button = pan
     * Middle mouse button = pan
     *
     * A normal click without movement still activates
     * the SVG link.
     */

    container.addEventListener(
        "mousedown",
        function (event) {

            const leftMouse =
                event.button === 0;

            const middleMouse =
                event.button === 1;

            if (!leftMouse && !middleMouse) {
                return;
            }

            event.preventDefault();

            isPanning = true;
            didPan = false;

            panStartX = event.clientX;
            panStartY = event.clientY;

            panStartViewX = viewX;
            panStartViewY = viewY;

            container.classList.add("is-panning");

        }
    );


    /*
     * =========================================================
     * PAN WHILE MOUSE MOVES
     * =========================================================
     */

    document.addEventListener(
        "mousemove",
        function (event) {

            if (!isPanning) {
                return;
            }

            const deltaX =
                event.clientX - panStartX;

            const deltaY =
                event.clientY - panStartY;


            /*
             * Don't consider it a drag until the mouse
             * has moved at least 5 pixels.
             */

            if (
                Math.abs(deltaX) > 5 ||
                Math.abs(deltaY) > 5
            ) {

                didPan = true;

            }


            if (!didPan) {
                return;
            }


            const rect =
                svg.getBoundingClientRect();


            /*
             * Convert screen pixels into SVG coordinates.
             */

            const dx =
                deltaX * (viewWidth / rect.width);

            const dy =
                deltaY * (viewHeight / rect.height);


            /*
             * Move the viewBox opposite the mouse.
             */

            viewX =
                panStartViewX - dx;

            viewY =
                panStartViewY - dy;


            updateViewBox();

        }
    );


    /*
     * =========================================================
     * END PAN
     * =========================================================
     */

    document.addEventListener(
        "mouseup",
        function (event) {

            if (!isPanning) {
                return;
            }

            isPanning = false;

            container.classList.remove("is-panning");


            /*
             * If the mouse actually moved, the browser
             * will normally generate a click afterward.
             *
             * Remember that we need to suppress that click.
             */

            if (didPan) {
                suppressNextClick = true;
            }

        }
    );


    /*
     * =========================================================
     * SUPPRESS CLICK AFTER A DRAG
     * =========================================================
     *
     * Important:
     *
     * Simple click  -> link works
     *
     * Drag          -> link does NOT activate
     *
     */

    container.addEventListener(
        "click",
        function (event) {

            if (!suppressNextClick) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            suppressNextClick = false;

        },
        true
    );


    /*
     * =========================================================
     * MIDDLE MOUSE
     * =========================================================
     *
     * Prevent normal middle-click behavior.
     */

    container.addEventListener(
        "auxclick",
        function (event) {

            if (event.button === 1) {

                event.preventDefault();

            }

        }
    );


    /*
     * =========================================================
     * SAFETY RESET
     * =========================================================
     */

    window.addEventListener(
        "blur",
        function () {

            isPanning = false;
            didPan = false;
            suppressNextClick = false;

            container.classList.remove("is-panning");

        }
    );

});
</script>
