{% if blogIndex %}

<section class="blog-posts">

  {% set blogCount = 0 %}

  {% for post in collections.note | reverse %}

    {% if post.data.tags and "blog" in post.data.tags %}

      {% set blogCount = blogCount + 1 %}

      <article class="blog-post">

        <div class="blog-post-meta">

          {% if post.data.tags %}
            <div class="blog-post-tags">
              {% for tag in post.data.tags %}
                {% if tag != "blog" and tag != "note" and tag != "gardenEntry" %}
                  <span class="blog-post-tag">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if post.data.date %}
            <time class="blog-post-date">
              {{ post.data.date | isoDate }}
            </time>
          {% endif %}

        </div>

        <h2 class="blog-post-title">
          <a href="{{ post.url }}">
            {{ post.data.title or post.fileSlug }}
          </a>
        </h2>

        {% if post.data.description %}
          <p class="blog-post-description">
            {{ post.data.description }}
          </p>
        {% endif %}

        <a class="blog-post-read-more" href="{{ post.url }}">
          Read more →
        </a>

      </article>

    {% endif %}

  {% endfor %}

  {% if blogCount == 0 %}
    <p class="blog-no-posts">
      No blog posts have been published yet.
    </p>
  {% endif %}

</section>

{% endif %}
