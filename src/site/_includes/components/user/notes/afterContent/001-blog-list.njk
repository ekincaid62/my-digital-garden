{% if page.fileSlug == "Ramblings" %}

<section class="blog-posts">

  {% for post in blogPosts %}

    {% if post.data.tags and "blog" in post.data.tags %}

      <article class="blog-post">

        <h2 class="blog-post-title">
          <a href="{{ post.url }}">{{ post.data.title or post.fileSlug }}</a>
        </h2>

        {% if post.data["dg-note-properties"] %}
          
          {% if post.data["dg-note-properties"].date %}
            <div class="blog-post-date">
              {{ post.data["dg-note-properties"].date }}
            </div>
          {% endif %}

          {% set firstImage = post | firstBlogImage %}

          {% if firstImage %}
            <div class="blog-post-image">
              <a href="{{ post.url }}">
                <img
                src="{{ firstImage }}"
                alt="{{ post.data.title or post.fileSlug }}"
                >
              </a>
            </div>
          {% endif %}

          {% if post.data["dg-note-properties"].description %}
            <p class="blog-post-description">
              {{ post.data["dg-note-properties"].description }}
            </p>
          {% endif %}

        {% endif %}

        <a class="blog-post-read-more" href="{{ post.url }}">
          Read more →
        </a>

      </article>

    {% endif %}

  {% endfor %}

</section>

{% endif %}
